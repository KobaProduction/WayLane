#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# The integration branch changes backend, frontend, Node and stable Agent.
# Verify each affected source owner without running deployment side effects.
base=""
if git rev-parse -q --verify refs/remotes/origin/main >/dev/null; then
  base="$(git merge-base HEAD refs/remotes/origin/main)"
fi
if [[ -n "$base" ]]; then
  changed="$(git diff --name-only "$base" HEAD)"
else
  changed=$'services/backend/\nservices/frontend/\nservices/node/\nservices/agent/'
fi
for service in backend frontend node; do
  if grep -q "^services/$service/" <<< "$changed"; then
    echo "[pre-push] verifying $service"
    (cd "services/$service" && ./scripts/verify.sh)
  fi
done
if grep -q "^services/agent/" <<< "$changed"; then
  echo "[pre-push] verifying agent"
  (cd services/agent && ./verify.sh)
fi
python="services/backend/.venv/bin/python"
if [[ ! -x "$python" ]]; then
  python=python3
fi
"$python" scripts/verify-layout.py

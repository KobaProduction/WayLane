# Bundled PostgreSQL operator inputs. Set a password manually; no auto-generation.
# Store actual secrets only in untracked .env or an approved protected
# secret provider, never in Git. Username defaults to waylane and is editable.
POSTGRES_USERNAME=waylane
POSTGRES_PASSWORD=
# POSTGRES_DATABASE=waylane

# Optional direct OTLP; empty endpoint disables export. Bearer is optional.
# OTEL_ENDPOINT=https://otel.example.com
# OTEL_BEARER_TOKEN=
# OTEL_NAMESPACE=waylane
# DEPLOYMENT_ENVIRONMENT=development

# Optional second approved OCI repository for independent Node releases.
# Set the SAME non-secret repository path in Backend and each Node Agent,
# after the registry has been installed and its TLS/pull access verified.
# WAYLANE_NODE_EXTRA_IMAGE_REPOSITORY=registry.example.com/waylane/node

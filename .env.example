# Bundled PostgreSQL operator inputs. Set a password manually; no auto-generation.
# Store actual secrets only in untracked .env or an approved protected
# secret provider, never in Git. Username defaults to waylane and is editable.
WAYLANE_POSTGRES_USERNAME=waylane
WAYLANE_POSTGRES_PASSWORD=
# WAYLANE_POSTGRES_DATABASE=waylane

# Optional direct OTLP; endpoint and bearer must be set together.
# OTLP_ENDPOINT=https://otel.example.com
# OTLP_BEARER_TOKEN=
# OTEL_SERVICE_NAMESPACE=waylane
# OTEL_DEPLOYMENT_ENVIRONMENT_NAME=development

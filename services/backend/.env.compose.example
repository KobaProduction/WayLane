# One canonical external connection string, as accepted by the existing
# WayLane backend settings. Username/password are required inside the URL.
# Percent-encode special characters in credentials.
SQLALCHEMY_DATABASE_URL=
# Optional direct OTLP (endpoint and token must be configured together).
# OTLP_ENDPOINT=https://otel.example.com
# OTLP_BEARER_TOKEN=
# OTEL_SERVICE_NAMESPACE=waylane
# OTEL_DEPLOYMENT_ENVIRONMENT_NAME=development
